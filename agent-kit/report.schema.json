{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/procrastinate-games/game-ai-usage/main/agent-kit/report.schema.json",
  "title": "Private-metadata-free AI token report",
  "description": "Report v2. Only an opaque, random report UUID, repo, day, accuracy and token data may be committed. Never include raw session IDs, task titles, start/end times, notes or transcripts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "repo",
    "date",
    "accuracy",
    "models"
  ],
  "properties": {
    "schema": {
      "const": "game-ai-usage/report@2"
    },
    "report_id": {
      "type": "string",
      "format": "uuid",
      "description": "Random UUID v4 not derived directly from source session id; stored only for dedup."
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "UTC calendar day only"
    },
    "accuracy": {
      "enum": [
        "exact",
        "partial",
        "unknown"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelRow"
      }
    }
  },
  "$defs": {
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "modelRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "anthropic",
            "openai",
            "google",
            "other"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_tier": {
          "enum": [
            "base",
            "long",
            null
          ]
        },
        "calls": {
          "$ref": "#/$defs/count"
        },
        "input_tokens": {
          "$ref": "#/$defs/count"
        },
        "output_tokens": {
          "$ref": "#/$defs/count"
        },
        "cache_read_tokens": {
          "$ref": "#/$defs/count"
        },
        "cache_write_tokens": {
          "$ref": "#/$defs/count"
        },
        "cache_write_5m_tokens": {
          "$ref": "#/$defs/count"
        },
        "cache_write_1h_tokens": {
          "$ref": "#/$defs/count"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/count"
        }
      }
    }
  }
}
